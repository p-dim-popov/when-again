{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "composite": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e",
    // e2e/client-home.spec.ts deep-imports the pure handoff codec (not the
    // module index, which re-exports React screens) — see the comment there.
    // Composite projects must list every file reachable from `include`, so
    // its leaf transitive deps are named explicitly rather than pulling in
    // all of `src` (which needs the app project's jsx/vite types).
    "src/modules/handoff/codec.ts",
    "src/modules/received/index.ts",
    "src/modules/received/received.ts",
    "src/modules/db/index.ts",
    "src/modules/db/db.ts",
    "src/modules/time/index.ts",
    "src/modules/time/wallClock.ts"
  ]
}
